# ── SearchAnvil environment template ──────────────────────────────────
# Copy to .env for local development: cp .env.example .env
# NEVER commit a real .env file.

# --- Node ---
NODE_ENV=development

# --- Database (Prisma / PostgreSQL) ---
# Port 5433 (not the Postgres default 5432) is what docker-compose.yml exposes,
# chosen to avoid colliding with other local Postgres instances. Adjust freely.
DATABASE_URL="postgresql://searchanvil:searchanvil_dev_password@localhost:5433/searchanvil?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6380"

# --- API ---
API_PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# --- Auth ---
# No AUTH_SECRET / signing secret is used or needed — session tokens are
# high-entropy random values (32 random bytes), and the SHA-256 hash used to
# index them server-side needs no secret/pepper (see docs/SECURITY.md).
AUTH_SESSION_COOKIE_NAME="searchanvil_session"
AUTH_SESSION_TTL_DAYS=30

# --- Crawler ---
CRAWLER_DEFAULT_USER_AGENT="SearchAnvilBot/0.1 (+https://searchanvil.com/bot)"
CRAWLER_MAX_PAGES_DEFAULT=200
CRAWLER_MAX_CONCURRENCY=5
CRAWLER_REQUEST_TIMEOUT_MS=15000

# --- Worker ---
WORKER_CONCURRENCY=5
# Independent, low-concurrency queue for browser-based performance sampling — see docs/PERFORMANCE.md
PERFORMANCE_WORKER_CONCURRENCY=1
# Absolute path to a provisioned Chromium binary (e.g. from `npx playwright install chromium`).
# If unset, the worker logs a warning and skips performance analysis entirely — crawls/audits are
# unaffected. See docs/PERFORMANCE.md ("Deployment requirement").
CHROMIUM_EXECUTABLE_PATH=

# --- Outbound email (password reset) ---
# Optional. If SMTP_HOST is unset, the API uses a deterministic console transport that never
# sends real email — the default for local dev and CI. Set these to enable real delivery via
# SMTP; never commit real credentials here. See docs/OPERATIONS.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@searchanvil.com
MAIL_FROM_NAME=SearchAnvil

# --- Web (Next.js public) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="SearchAnvil"
