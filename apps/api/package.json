    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/throttler": "^6.3.0",
    "@searchenvil/database": "workspace:*",
    "@searchenvil/shared": "workspace:*",
    "@searchenvil/crawler": "workspace:*",
    "@searchenvil/queue": "workspace:*",
    "bullmq": "^5.34.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
