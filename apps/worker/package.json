{
  "name": "@searchanvil/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@searchanvil/database": "workspace:*",
    "@searchanvil/queue": "workspace:*",
    "@searchanvil/shared": "workspace:*",
    "@searchanvil/crawler": "workspace:*",
    "@searchanvil/audit-engine": "workspace:*",
    "@searchanvil/performance": "workspace:*"
  },
  "devDependencies": {
    "@searchanvil/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "eslint": "^8.57.1",
    "@searchanvil/eslint-config": "workspace:*"
  }
}
